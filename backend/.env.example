# Required: PostgreSQL connection used by Alembic and the FastAPI app
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname
SECRET_KEY=your_jwt_secret_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ADMIN_EMAIL=AutoPartBazaar21@gmail.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: AWS S3 for product images.
# If left blank, uploaded images are stored locally under backend/static/product-images/.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=

# Optional: Gmail / SMTP for password-reset OTP emails.
# If left blank, /generateOTP and /resendOTP return 503 in local development.
# EMAIL_USER = your full Gmail address (e.g. you@gmail.com)
# EMAIL_PASS = a Gmail "App Password" (16 chars) — NOT your normal password.
#   Generate at: https://myaccount.google.com/apppasswords (2-Step Verification must be ON).
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Online payment provider selection:
#   auto     = JazzCash if its credentials are set below, else a built-in DEMO
#              gateway (no account / no real money — great for testing & FYP demo).
#   jazzcash = always JazzCash (online payment hidden if not configured).
#   mock     = always the built-in demo gateway.
PAYMENT_MODE=auto

# Optional: JazzCash online payment (HTTP POST / Page Redirection).
# Leave the three credentials blank to use the demo gateway instead (PAYMENT_MODE=auto).
# Get sandbox credentials from the JazzCash merchant sandbox portal.
FRONTEND_BASE_URL=http://localhost:5173
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_SANDBOX=true
# Browser is redirected back here after payment; must be reachable from the customer's browser.
JAZZCASH_RETURN_URL=http://localhost:8000/payments/jazzcash/callback
# Leave empty so the JazzCash page offers wallet + debit/credit card + OTC.
# Set to MWALLET to force wallet-only.
JAZZCASH_TXN_TYPE=

# Optional: AI recommendation endpoint via OpenRouter / Gemma.
GEMMA_API_KEY=
USD_TO_PKR_RATE=279.31

# Optional: daily live parts sync. Use comma-separated entries in NAME|URL format.
# Example:
# PARTS_FEED_URLS=TireRack|https://example.com/feed.json,eBay|https://example.com/product-page
PARTS_SYNC_ENABLED=false
PARTS_SYNC_RUN_ON_STARTUP=true
PARTS_SYNC_HOUR=1
PARTS_SYNC_MINUTE=0
PARTS_FEED_URLS=
PARTS_SYNC_TIMEOUT_SECONDS=20

# Region & category filters
PARTS_FILTER_CITY=Lahore
PARTS_FILTER_VEHICLE_TYPES=car

# Markup % added on top of every fetched/synced product price (e.g. 5.0 = +5%).
# Applies to both the sale price and the "original" (pre-discount) price so the
# discount percentage shown on the product page stays consistent.
PARTS_MARKUP_PERCENT=5.0
